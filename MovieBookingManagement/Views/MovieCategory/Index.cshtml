@model IEnumerable<MovieBookingManagement.Models.MovieCategoryModel>

@{
    ViewBag.Title = "Movie Categories";
}

<div class="container" style="margin-top:30px;">

    <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2>Movie Categories</h2>

        <a href="@Url.Action("Create", "MovieCategory")"
           class="btn btn-primary">
            + Add Category
        </a>
    </div>

    <hr />

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Category ID</th>
                    <th>Category Name</th>
                    <th style="width:200px;">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Cat_ID</td>

                        <td>@item.Cat_Type</td>

                        <td>
                            <a href="@Url.Action("Edit", "MovieCategory",
                                      new { id = item.Cat_ID })"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a href="@Url.Action("Delete", "MovieCategory",
                                      new { id = item.Cat_ID })"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Are you sure you want to delete this category?');">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No movie categories found.
        </div>
    }

</div>