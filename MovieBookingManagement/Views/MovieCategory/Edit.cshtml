@model MovieBookingManagement.Models.MovieCategoryModel

@{
    ViewBag.Title = "Edit Movie Category";
}

<div class="container" style="margin-top:30px;">

    <h2>Edit Movie Category</h2>

    <hr />

    @using (Html.BeginForm("Edit", "MovieCategory", FormMethod.Post))
    {
        @Html.HiddenFor(model => model.Cat_ID)

        <div class="form-group">
            <label>Category Name</label>

            @Html.TextBoxFor(
                model => model.Cat_Type,
                new
                {
                    @class = "form-control",
                    placeholder = "Enter category name"
                }
            )

            @Html.ValidationMessageFor(
                model => model.Cat_Type,
                "",
                new { @class = "text-danger" }
            )
        </div>

        <br />

        <button type="submit" class="btn btn-primary">
            Update Category
        </button>

        <a href="@Url.Action("Index", "MovieCategory")"
           class="btn btn-secondary">
            Back
        </a>
    }

</div>